{
	"name": "server",
	"version": "0.1.0",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "next dev --turbopack --hostname=0.0.0.0",
		"dev:network": "next dev --turbopack --hostname=0.0.0.0",
		"build": "prisma generate && next build",
		"start": "next start",
		"postinstall": "prisma generate",
		"db:push": "prisma db push",
		"db:studio": "prisma studio",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate dev",
		"db:reset": "prisma migrate reset",
		"db:seed": "bun run src/lib/seed.ts",
		"db:optimize": "bun run src/scripts/run-db-optimization.ts",
		"db:health": "curl -s http://localhost:3000/api/health | jq .",
		"db:fix": "bun run src/scripts/fix-neon-connection.ts",
		"db:wake": "curl -X POST http://localhost:3000/api/wake-db",
		"type-check": "tsc --noEmit",
		"lint": "eslint . --ext .ts,.tsx",
		"lint:fix": "eslint . --ext .ts,.tsx --fix"
	},
	"dependencies": {
		"@node-rs/argon2": "^2.0.2",
		"@orpc/client": "^1.8.4",
		"@orpc/server": "^1.8.4",
		"@paralleldrive/cuid2": "^2.2.2",
		"@prisma/client": "^6.13.0",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/multer": "^2.0.0",
		"@types/puppeteer": "^7.0.4",
		"bcrypt": "^6.0.0",
		"cookie": "^1.0.2",
		"dotenv": "^17.2.1",
		"jsonwebtoken": "^9.0.2",
		"multer": "^2.0.2",
		"next": "15.5.0",
		"puppeteer": "^24.17.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"sharp": "^0.34.3"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.1",
		"@types/bcrypt": "^6.0.0",
		"@types/bun": "^1.2.6",
		"@types/node": "^20",
		"@types/react": "^19",
		"@typescript-eslint/eslint-plugin": "^8.41.0",
		"@typescript-eslint/parser": "^8.41.0",
		"eslint": "^9.34.0",
		"eslint-config-next": "^15.5.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.4",
		"prettier": "^3.6.2",
		"prisma": "^6.13.0",
		"typescript": "^5",
		"zod": "^4.0.13"
	}
}
