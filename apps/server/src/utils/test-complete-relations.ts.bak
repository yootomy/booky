import { db } from "./db";

// =============================================================================
// 🧪 TESTS COMPLETS DES RELATIONS BIDIRECTIONNELLES
// =============================================================================

async function testCompleteRelations() {
  console.log("🔍 Testing Complete Bidirectional Relations...\n");
  
  const baseUrl = "http://localhost:3001";
  
  try {
    // =============================================================================
    // 🔧 Test Setup - Récupérer des données de test
    // =============================================================================
    console.log("🔧 Setting up test data:");
    
    let testBookId = null;
    let testTagId = null;
    let testCategoryId = null;
    let testBookTitle = null;
    let testTagName = null;
    let testCategoryName = null;
    
    // Récupérer un livre de test
    try {
      const booksResponse = await fetch(`${baseUrl}/api/books?limit=1`);
      const booksResult = await booksResponse.json();
      if (booksResult.success && booksResult.data && booksResult.data.length > 0) {
        testBookId = booksResult.data[0].id;
        testBookTitle = booksResult.data[0].titre;
        console.log(`  📖 Using test book: ${testBookId} - "${testBookTitle}"`);
      }
    } catch (error) {
      console.log(`  ⚠️ Could not fetch test book: ${error}`);
    }

    // Récupérer un tag de test
    try {
      const tagsResponse = await fetch(`${baseUrl}/api/tags?limit=1`);
      const tagsResult = await tagsResponse.json();
      if (tagsResult.success && tagsResult.data && tagsResult.data.length > 0) {
        testTagId = tagsResult.data[0].id;
        testTagName = tagsResult.data[0].nom;
        console.log(`  🏷️ Using test tag: ${testTagId} - "${testTagName}"`);
      }
    } catch (error) {
      console.log(`  ⚠️ Could not fetch test tag: ${error}`);
    }

    // Récupérer une catégorie de test
    try {
      const categoriesResponse = await fetch(`${baseUrl}/api/categories?limit=1`);
      const categoriesResult = await categoriesResponse.json();
      if (categoriesResult.success && categoriesResult.data && categoriesResult.data.length > 0) {
        testCategoryId = categoriesResult.data[0].id;
        testCategoryName = categoriesResult.data[0].nom;
        console.log(`  📂 Using test category: ${testCategoryId} - "${testCategoryName}"`);
      }
    } catch (error) {
      console.log(`  ⚠️ Could not fetch test category: ${error}`);
    }

    if (!testBookId || !testTagId || !testCategoryId) {
      console.log("⚠️ Skipping tests - insufficient test data");
      return;
    }

    // =============================================================================
    // 📚 Test 1: Relations Livre → Catégories (déjà implémentées)
    // =============================================================================
    console.log("\n📚 Testing Book → Categories relations:");
    
    const bookToCategoriesTests = [
      {
        name: "GET /api/books/:id/categories - Catégories d'un livre",
        url: `${baseUrl}/api/books/${testBookId}/categories`,
        method: "GET",
        expectedStatus: 200,
        description: "Récupère toutes les catégories associées à un livre"
      },
      {
        name: "POST /api/books/:id/categories - Ajouter catégories au livre",
        url: `${baseUrl}/api/books/${testBookId}/categories`,
        method: "POST",
        body: JSON.stringify({ category_ids: [testCategoryId] }),
        headers: { "Content-Type": "application/json" },
        expectedStatus: [200, 401],
        description: "Ajoute des catégories à un livre (nécessite auth)"
      },
      {
        name: "DELETE /api/books/:id/categories/:categoryId - Dissocier catégorie",
        url: `${baseUrl}/api/books/${testBookId}/categories/${testCategoryId}`,
        method: "DELETE",
        expectedStatus: [200, 401, 404],
        description: "Supprime une catégorie spécifique d'un livre"
      }
    ];

    for (const test of bookToCategoriesTests) {
      await runTest(test);
    }

    // =============================================================================
    // 🏷️ Test 2: Relations Livre → Tags (déjà implémentées)
    // =============================================================================
    console.log("\n🏷️ Testing Book → Tags relations:");
    
    const bookToTagsTests = [
      {
        name: "GET /api/books/:id/tags - Tags d'un livre",
        url: `${baseUrl}/api/books/${testBookId}/tags`,
        method: "GET",
        expectedStatus: 200,
        description: "Récupère tous les tags associés à un livre avec groupement par type"
      },
      {
        name: "POST /api/books/:id/tags - Ajouter tags au livre",
        url: `${baseUrl}/api/books/${testBookId}/tags`,
        method: "POST",
        body: JSON.stringify({ tag_ids: [testTagId] }),
        headers: { "Content-Type": "application/json" },
        expectedStatus: [200, 401],
        description: "Ajoute des tags à un livre (nécessite auth)"
      },
      {
        name: "DELETE /api/books/:id/tags/:tagId - Dissocier tag",
        url: `${baseUrl}/api/books/${testBookId}/tags/${testTagId}`,
        method: "DELETE",
        expectedStatus: [200, 401, 404],
        description: "Supprime un tag spécifique d'un livre"
      }
    ];

    for (const test of bookToTagsTests) {
      await runTest(test);
    }

    // =============================================================================
    // 📂 Test 3: Relations Catégorie → Livres (relations bidirectionnelles)
    // =============================================================================
    console.log("\n📂 Testing Category → Books relations:");
    
    const categoryToBooksTests = [
      {
        name: "GET /api/categories/:id/books - Livres d'une catégorie",
        url: `${baseUrl}/api/categories/${testCategoryId}/books`,
        method: "GET",
        expectedStatus: 200,
        description: "Récupère tous les livres associés à une catégorie avec filtres"
      },
      {
        name: "GET /api/categories/:id/books avec filtres",
        url: `${baseUrl}/api/categories/${testCategoryId}/books?page=1&limit=5&sort=titre&order=asc`,
        method: "GET",
        expectedStatus: 200,
        description: "Test avec pagination et tri"
      },
      {
        name: "GET /api/categories/:id/books avec filtres avancés",
        url: `${baseUrl}/api/categories/${testCategoryId}/books?statut=LU&niveau_spicy=3&min_rating=4.0`,
        method: "GET",
        expectedStatus: 200,
        description: "Test avec filtres de contenu et notation"
      },
      {
        name: "POST /api/categories/:id/books - Associer livres à catégorie",
        url: `${baseUrl}/api/categories/${testCategoryId}/books`,
        method: "POST",
        body: JSON.stringify({ book_ids: [testBookId] }),
        headers: { "Content-Type": "application/json" },
        expectedStatus: [200, 401],
        description: "Associe des livres à une catégorie (direction inverse)"
      },
      {
        name: "DELETE /api/categories/:id/books - Dissocier livres d'une catégorie",
        url: `${baseUrl}/api/categories/${testCategoryId}/books`,
        method: "DELETE",
        expectedStatus: [200, 401],
        description: "Supprime tous les livres d'une catégorie"
      },
      {
        name: "DELETE /api/categories/:id/books avec IDs spécifiques",
        url: `${baseUrl}/api/categories/${testCategoryId}/books?book_ids=${testBookId}`,
        method: "DELETE",
        expectedStatus: [200, 401],
        description: "Supprime des livres spécifiques d'une catégorie"
      }
    ];

    for (const test of categoryToBooksTests) {
      await runTest(test);
    }

    // =============================================================================
    // 🏷️ Test 4: Relations Tag → Livres (relations bidirectionnelles)
    // =============================================================================
    console.log("\n🏷️ Testing Tag → Books relations:");
    
    const tagToBooksTests = [
      {
        name: "GET /api/tags/:id/books - Livres d'un tag",
        url: `${baseUrl}/api/tags/${testTagId}/books`,
        method: "GET",
        expectedStatus: 200,
        description: "Récupère tous les livres associés à un tag avec filtres"
      },
      {
        name: "GET /api/tags/:id/books avec filtres",
        url: `${baseUrl}/api/tags/${testTagId}/books?page=1&limit=5&sort=note_generale&order=desc`,
        method: "GET",
        expectedStatus: 200,
        description: "Test avec pagination et tri par note"
      },
      {
        name: "GET /api/tags/:id/books avec filtres de contenu",
        url: `${baseUrl}/api/tags/${testTagId}/books?niveau_dark=2&statut=LU`,
        method: "GET",
        expectedStatus: 200,
        description: "Test avec filtres de niveau et statut"
      },
      {
        name: "POST /api/tags/:id/books - Associer livres à tag",
        url: `${baseUrl}/api/tags/${testTagId}/books`,
        method: "POST",
        body: JSON.stringify({ book_ids: [testBookId] }),
        headers: { "Content-Type": "application/json" },
        expectedStatus: [200, 401],
        description: "Associe des livres à un tag (direction inverse)"
      },
      {
        name: "DELETE /api/tags/:id/books - Dissocier livres d'un tag",
        url: `${baseUrl}/api/tags/${testTagId}/books`,
        method: "DELETE",
        expectedStatus: [200, 401],
        description: "Supprime tous les livres d'un tag"
      },
      {
        name: "DELETE /api/tags/:id/books avec IDs spécifiques",
        url: `${baseUrl}/api/tags/${testTagId}/books?book_ids=${testBookId}`,
        method: "DELETE",
        expectedStatus: [200, 401],
        description: "Supprime des livres spécifiques d'un tag"
      }
    ];

    for (const test of tagToBooksTests) {
      await runTest(test);
    }

    // =============================================================================
    // 📊 Test 5: Cohérence des compteurs et statistiques
    // =============================================================================
    console.log("\n📊 Testing counters and statistics consistency:");
    
    const statsTests = [
      {
        name: "GET /api/tags/stats - Statistiques des tags",
        url: `${baseUrl}/api/tags/stats`,
        method: "GET",
        expectedStatus: 200,
        description: "Vérifier la cohérence des statistiques des tags"
      },
      {
        name: "GET /api/categories/stats - Statistiques des catégories",
        url: `${baseUrl}/api/categories/stats`,
        method: "GET",
        expectedStatus: 200,
        description: "Vérifier la cohérence des statistiques des catégories"
      },
      {
        name: "GET /api/tags/:id avec compteur",
        url: `${baseUrl}/api/tags/${testTagId}?include_book_count=true`,
        method: "GET",
        expectedStatus: 200,
        description: "Vérifier que le compteur de livres par tag est correct"
      }
    ];

    for (const test of statsTests) {
      await runTest(test);
    }

    // =============================================================================
    // 🔍 Test 6: Validation des erreurs sur toutes les routes
    // =============================================================================
    console.log("\n🔍 Testing error validation across all relations:");
    
    const errorValidationTests = [
      {
        name: "Catégorie inexistante → Livres",
        url: `${baseUrl}/api/categories/00000000-0000-0000-0000-000000000000/books`,
        method: "GET",
        expectedStatus: 404,
        description: "Test d'erreur pour catégorie non trouvée"
      },
      {
        name: "Tag inexistant → Livres",
        url: `${baseUrl}/api/tags/00000000-0000-0000-0000-000000000000/books`,
        method: "GET",
        expectedStatus: 404,
        description: "Test d'erreur pour tag non trouvé"
      },
      {
        name: "Livre inexistant → Catégories",
        url: `${baseUrl}/api/books/00000000-0000-0000-0000-000000000000/categories`,
        method: "GET",
        expectedStatus: 404,
        description: "Test d'erreur pour livre non trouvé"
      },
      {
        name: "Livre inexistant → Tags",
        url: `${baseUrl}/api/books/00000000-0000-0000-0000-000000000000/tags`,
        method: "GET",
        expectedStatus: 404,
        description: "Test d'erreur pour livre non trouvé"
      }
    ];

    for (const test of errorValidationTests) {
      await runTest(test);
    }

    console.log("\n🎉 Complete Relations Tests Finished!");
    console.log("📋 Relations Matrix Summary:");
    console.log("   ✅ Livre → Catégories (GET, POST, PUT, DELETE)");
    console.log("   ✅ Livre → Tags (GET, POST, PUT, DELETE)");
    console.log("   ✅ Catégorie → Livres (GET, POST, DELETE)");
    console.log("   ✅ Tag → Livres (GET, POST, DELETE)");
    console.log("   ✅ Relations bidirectionnelles complètes");
    console.log("   ✅ Filtrage et pagination sur toutes les relations");
    console.log("   ✅ Gestion des compteurs et statistiques");
    console.log("   ✅ Authentication et autorisation");
    console.log("   ✅ Validation et gestion d'erreurs");

  } catch (error) {
    console.error("\n💥 Complete relations tests failed:", error);
    throw error;
  }
}

// =============================================================================
// 🎯 FONCTION UTILITAIRE POUR EXÉCUTER LES TESTS
// =============================================================================

async function runTest(test) {
  try {
    const startTime = Date.now();
    const requestOptions = {
      method: test.method,
      headers: test.headers || {},
      body: test.body
    };

    const response = await fetch(test.url, requestOptions);
    const responseTime = Date.now() - startTime;
    
    let result;
    try {
      result = await response.json();
    } catch {
      result = { error: "Invalid JSON response" };
    }
    
    const isExpectedStatus = Array.isArray(test.expectedStatus) 
      ? test.expectedStatus.includes(response.status)
      : response.status === test.expectedStatus;

    if (isExpectedStatus) {
      console.log(`  ✅ ${test.name}: Status ${response.status} (${responseTime}ms)`);
      
      // Affichage contextuel selon le type de réponse
      if (response.status === 200 && result.success) {
        if (test.method === "GET") {
          // Pour les GET, afficher les informations des données
          if (result.data && Array.isArray(result.data)) {
            console.log(`     📊 Found: ${result.data.length} items`);
            if (result.pagination) {
              console.log(`     📄 Total: ${result.pagination.totalCount}, Page: ${result.pagination.currentPage}/${result.pagination.totalPages}`);
            }
          } else if (result.data) {
            // Single item response
            if (result.data.book) {
              console.log(`     📖 Book: ${result.data.book.titre || 'N/A'}`);
            }
            if (result.data.total_categories !== undefined) {
              console.log(`     📂 Categories: ${result.data.total_categories}`);
            }
            if (result.data.total_tags !== undefined) {
              console.log(`     🏷️ Tags: ${result.data.total_tags}`);
            }
          }
          // Pour les relations category/tag → books
          if (result.category) {
            console.log(`     📂 Category: ${result.category.nom}`);
          }
          if (result.tag) {
            console.log(`     🏷️ Tag: ${result.tag.nom} (${result.tag.type})`);
          }
          // Pour les statistiques
          if (result.stats) {
            console.log(`     📊 Stats: ${Object.keys(result.stats).length} metrics`);
          }
          if (result.execution_time_ms) {
            console.log(`     ⚡ Server time: ${result.execution_time_ms}ms`);
          }
        } else if (test.method === "POST") {
          console.log(`     ➕ Created: ${result.data?.associations_created || 0} associations`);
          if (result.message) {
            console.log(`     💬 Message: ${result.message}`);
          }
        } else if (test.method === "DELETE") {
          console.log(`     ➖ Removed: ${result.data?.dissociations_count || 0} associations`);
          if (result.message) {
            console.log(`     💬 Message: ${result.message}`);
          }
        }
      } else if (response.status === 401) {
        console.log(`     🔒 Auth required: ${result.error || 'Unauthorized'}`);
      } else if (response.status === 404) {
        console.log(`     🔍 Not found: ${result.error || 'Resource not found'}`);
      } else if (response.status === 400) {
        console.log(`     ⚠️ Bad request: ${result.error || 'Invalid request'}`);
      }
      
      if (test.description) {
        console.log(`     📝 ${test.description}`);
      }
    } else {
      console.log(`  ❌ ${test.name}: Status ${response.status} (Expected ${test.expectedStatus})`);
      if (result.error) console.log(`     💥 Error: ${result.error}`);
      if (result.code) console.log(`     🏷️ Code: ${result.code}`);
    }
  } catch (error) {
    console.log(`  ❌ ${test.name}: Network error - ${error}`);
  }
}

// =============================================================================
// 🎨 DÉMONSTRATION DE L'ARCHITECTURE DES RELATIONS
// =============================================================================

async function demonstrateRelationsArchitecture() {
  console.log("\n" + "=".repeat(80));
  console.log("🎨 ARCHITECTURE COMPLÈTE DES RELATIONS BIDIRECTIONNELLES");
